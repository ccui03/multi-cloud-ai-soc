# Copy to repository root as .env.aliyun and fill in locally.
# Never commit the real .env.aliyun file.
# Use an Alibaba Cloud RAM user/role with read-only access to the required SLS project/logstore.

ALIYUN_ACCESS_KEY_ID=
ALIYUN_ACCESS_KEY_SECRET=
ALIYUN_SLS_ENDPOINT=
ALIYUN_SLS_PROJECT=
ALIYUN_SLS_LOGSTORE=
ALIYUN_SLS_REGION=
