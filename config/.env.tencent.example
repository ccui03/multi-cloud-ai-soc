# Copy to repository root as .env.tencent and fill in locally.
# Never commit the real .env.tencent file.
# Use a Tencent Cloud CAM user/role with cls:SearchLog read-only permission.
# SearchLog uses the Tencent Cloud API endpoint, normally cls.tencentcloudapi.com.

TENCENT_SECRET_ID=
TENCENT_SECRET_KEY=
TENCENT_CLS_ENDPOINT=cls.tencentcloudapi.com
TENCENT_CLS_REGION=
TENCENT_CLS_TOPIC_ID=
